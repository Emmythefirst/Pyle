.anchor
.DS_Store
**/*.rs.bk
node_modules
test-ledger
.yarn

# Anchor build output -- everything except the two IDL directories below,
# which backend/frontend need at runtime to build Program clients and which
# a hosted backend (no local Anchor toolchain) has no other way to get. A
# bare "target" previously caught every target/ dir recursively (including
# a stray programs/transfer-hook/target/deploy/*-keypair.json); **/target/*
# preserves that reach so a keypair left in some other nested target/ stays
# covered too, and the .so binaries + Rust build cache stay ignored (large).
**/target/*
!/target/idl
!/arcium-mpc/target/idl
/target/idl/*
!/target/idl/*.json
/arcium-mpc/target/idl/*
!/arcium-mpc/target/idl/*.json

# frontend / backend
dist
build
.env
.env.local
*.log

# local-only project notes, never pushed
progress.md

# backup of program deploy keypairs (upgrade authority for
# eligibility-credential + transfer-hook) -- target/deploy/ is gitignored
# above and would be unrecoverable if wiped; this is a local-only safety
# copy, never pushed, same handling as progress.md
.local-keys/

# arcium-mpc/build holds the compiled circuit (.arcis) the MPC cluster
# fetches via the comp-def's OffChain source URL -- a required deployment
# artifact, not transient JS build output, so it's exempted from the
# "build" rule above. The .lock/.touch files alongside it are arcium build's
# own transient bookkeeping, not real artifacts, so they stay excluded.
!arcium-mpc/build
arcium-mpc/build/*.lock
arcium-mpc/build/*.touch

# vendored, patched copies of anchor-lang & co used in a (reverted) attempt
# to work around an upstream arcium-anchor@0.15.0/anchor-lang@1.0.2 bug --
# see progress.md §12.7. Reproducible from the cargo cache; not worth
# tracking.
arcium-mpc/vendor/
