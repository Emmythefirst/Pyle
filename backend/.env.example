RPC_URL=https://api.devnet.solana.com
WS_PORT=8787

# Program IDs default to Pyle's deployed devnet addresses -- only set these
# if deploying fresh copies.
# TRANSFER_HOOK_PROGRAM_ID=
# ELIGIBILITY_CREDENTIAL_PROGRAM_ID=

# Set once a demo pool exists -- each test run creates and abandons its own
# (progress.md §9-§11), so there's no single persistent pool to default to.
# Curve-progress data reports as "not configured" until this is set.
# DBC_POOL_ADDRESS=

# POOL_POLL_INTERVAL_MS=5000
# CREDENTIAL_POLL_INTERVAL_MS=10000
